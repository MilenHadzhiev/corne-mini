#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define TIMEOUT 180
#define IDLE_TIMEOUT 100

/ {
    behaviors {
        // Number row tap-dance behaviors

        td_q: td_q {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp Q>, <&kp N1>;
        };

        td_w: td_w {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp W>, <&kp N2>;
        };

        td_e: td_e {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp E>, <&kp N3>;
        };

        td_r: td_r {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp R>, <&kp N4>;
        };

        td_t: td_t {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp T>, <&kp N5>;
        };

        td_y: td_y {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp Y>, <&kp N6>;
        };

        td_u: td_u {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp U>, <&kp N7>;
        };

        td_i: td_i {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp I>, <&kp N8>;
        };

        td_o: td_o {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp O>, <&kp N9>;
        };

        td_p: td_p {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp P>, <&kp N0>;
        };

        // Symbol tap-dance behaviors

        td_semi: td_semi {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp SEMICOLON>, <&kp SQT>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp V>, <&kp NON_US_BACKSLASH>;
        };

        td_n: td_n {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp N>, <&kp MINUS>;
        };

        td_h: td_h {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp H>, <&kp LEFT_BRACKET>;
        };

        td_j: td_j {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp J>, <&kp RIGHT_BRACKET>;
        };

        td_l: td_l {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp L>, <&kp EQUAL>;
        };

        td_minus: td_minus {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp MINUS>, <&kp UNDERSCORE>;
        };

        td_b: td_b {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp B>, <&kp GRAVE>;
        };

        td_backslash: td_backslash {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp BACKSLASH>, <&kp PIPE>;
        };

        td_pipe: td_pipe {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp PIPE>, <&kp BACKSLASH>;
        };

        td_plus: td_plus {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp PLUS>, <&kp EQUAL>;
        };

	a_esc: a_esc_behavior {
	    compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
	    flavor = "balanced";
            required-prior-idle-ms = <IDLE-TIMEOUT>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp>, <&kp>;
	}
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&trans  &td_q      &td_w       &td_e         &td_r       &td_t        &td_y    &td_u     &td_i         &td_o       &td_p      &trans
&trans  &mt ESC A  &mt LGUI S  &mt LSHIFT D  &mt LALT F  &mt TAB G    &td_h    &td_j     &mt RSHIFT K  &td_l       &td_semi   &trans
&trans  &kp Z      &kp X       &kp C         &td_v       &td_b        &td_n    &kp M     &kp COMMA     &kp PERIOD  &kp SLASH  &trans
                               &mo 1         &kp LCTRL   &kp SPACE    &kp RET  &kp BSPC  &mo 2
            >;
        };

        lower_layer {
            bindings = <
&trans  &kp N1      &kp N2         &kp N3     &kp N4        &kp N5       &kp N6            &kp N7         &kp N8     &kp N9      &kp N0         &trans
&trans  &kp ESCAPE  &kp LCMD       &kp LSHFT  &kp LEFT_ALT  &kp TAB      &kp LEFT_BRACKET  &kp UP_ARROW   &kp RSHFT  &kp EQUAL   &kp SEMICOLON  &trans
&trans  &td_plus    &td_backslash  &td_pipe   &td_minus     &kp GRAVE    &kp LEFT          &kp DOWN       &kp RIGHT  &kp PERIOD  &kp SLASH      &trans
                                   &trans     &kp LCTRL     &kp SPACE    &kp RET           &kp BACKSPACE  &kp RALT
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp F1        &kp F2         &kp F3        &kp F4        &kp F5          &kp F6      &kp F7         &kp F8      &kp F9  &kp F10  &trans
&trans  &bt BT_CLR    &kp LEFT_META  &kp LSHIFT    &kp LALT      &trans          &kp F11     &kp F12        &kp DELETE  &trans  &trans   &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp INSERT  &trans         &trans      &trans  &trans   &trans
                                     &kp LGUI      &kp LCTRL     &kp SPACE       &kp RET     &kp BACKSPACE  &kp RALT
            >;
        };
    };
};
