#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define TIMEOUT 170
#define IDLE_TIMEOUT 130

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Number row tap-dance behaviors

        td_q: td_q {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp Q>, <&kp N1>;
        };

        td_w: td_w {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp W>, <&kp N2>;
        };

        td_e: td_e {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp E>, <&kp N3>;
        };

        td_r: td_r {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp R>, <&kp N4>;
        };

        td_t: td_t {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp T>, <&kp N5>;
        };

        td_y: td_y {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp Y>, <&kp N6>;
        };

        td_u: td_u {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp U>, <&kp N7>;
        };

        td_i: td_i {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp I>, <&kp N8>;
        };

        td_o: td_o {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp O>, <&kp N9>;
        };

        td_p: td_p {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp P>, <&kp N0>;
        };

        // Symbol tap-dance behaviors

        td_semi: td_semi {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp SEMICOLON>, <&kp SQT>;
        };

        td_n: td_n {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp N>, <&kp MINUS>;
        };

        td_h: td_h {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp H>, <&kp LEFT_BRACKET>;
        };

        td_j: td_j {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp J>, <&kp RIGHT_BRACKET>;
        };

        td_l: td_l {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp L>, <&kp EQUAL>;
        };

        td_b: td_b {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TIMEOUT>;
            bindings = <&kp B>, <&kp TILDE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&trans  &td_q      &td_w       &td_e         &td_r       &td_t        &td_y    &td_u     &td_i         &td_o                  &td_p      &trans
&trans  &hm ESC A  &hm LGUI S  &hm LSHIFT D  &hm LALT F  &mt TAB G    &kp H    &kp J     &hm RSHIFT K  &kp L                  &td_semi   &trans
&trans  &kp Z      &kp X       &kp C         &kp V       &kp B        &kp N    &kp M     &kp COMMA     &hm RIGHT_META PERIOD  &kp SLASH  &trans
                               &mo 1         &kp LCTRL   &kp SPACE    &kp RET  &kp BSPC  &mo 2
            >;
        };

        lower_layer {
            bindings = <
&trans  &kp N1      &kp N2    &kp N3         &kp N4        &kp N5       &kp N6     &kp N7         &kp N8                  &kp N9             &kp N0   &trans
&trans  &kp ESCAPE  &kp LCMD  &kp LSHFT      &kp LEFT_ALT  &kp TAB      &kp EQUAL  &kp UP_ARROW   &hm RSHFT LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT  &trans
&trans  &kp CAPS    &none     &kp BACKSLASH  &kp MINUS     &kp GRAVE    &kp LEFT   &kp DOWN       &kp RIGHT               &none              &none    &trans
                              &trans         &kp LCTRL     &kp SPACE    &kp RET    &kp BACKSPACE  &kp RALT
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp F1        &kp F2         &kp F3        &kp F4        &kp F5          &kp F6      &kp F7         &kp F8      &kp F9  &kp F10  &trans
&trans  &bt BT_CLR    &kp LEFT_META  &kp LSHIFT    &kp LALT      &trans          &kp F11     &kp F12        &kp DELETE  &trans  &trans   &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp INSERT  &trans         &trans      &trans  &trans   &trans
                                     &kp LGUI      &kp LCTRL     &kp SPACE       &kp RET     &kp BACKSPACE  &kp RALT
            >;
        };
    };
};
